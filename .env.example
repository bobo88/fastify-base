# 应用配置
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# JWT配置
JWT_SECRET=my-super-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# CORS配置
CORS_ORIGIN=true

# 速率限制配置
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Swagger文档配置
ENABLE_SWAGGER=true
SWAGGER_HOST=localhost:3000

# 数据库配置（可选）
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=fastify_base
# DB_USER=postgres
# DB_PASSWORD=password